[Unit]
Description=SOLVENT receipt anchor — post the daily chain head under the ERC-8004 identity
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
EnvironmentFile=-/etc/solvent/telegram-alerts
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/solvent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ExecStart=/opt/solvent/.venv/bin/python -m solvent.receipts.anchor --data-dir ${SOLVENT_DATA_DIR} --update-existing
