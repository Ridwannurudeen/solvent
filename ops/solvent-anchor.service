[Unit]
Description=SOLVENT receipt anchor — post the daily chain head under the ERC-8004 identity
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
ExecStart=/opt/solvent/.venv/bin/python -m solvent.receipts.anchor --data-dir ${SOLVENT_DATA_DIR} --update-existing
