[Unit]
Description=Anchor the SOLVENT receipt chain head daily at 23:55 UTC
# After the trading day's receipts are written, before the next UTC day.
# Explicit UTC suffix fires after the 23:00 UTC decision cycle.

[Timer]
OnCalendar=*-*-* 23:55:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
