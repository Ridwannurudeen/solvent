[Unit]
Description=Anchor the SOLVENT receipt chain head daily at 23:00 UTC
# After the trading day's receipts are written, before the next UTC day.
# Explicit UTC suffix → fires at 23:00 UTC regardless of host timezone.

[Timer]
OnCalendar=*-*-* 23:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
