[Unit]
Description=SOLVENT deadman — fire the daily qualification trade if unqualified
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
ExecStart=/opt/solvent/.venv/bin/python -m solvent.ops.deadman --mode ${SOLVENT_MODE} --data-dir ${SOLVENT_DATA_DIR}
