# Copy to /opt/solvent/solvent.env and fill in. Never commit the real file.

# Run mode: paper (default for local dev) | live. Production uses live with
# an isolated SOLVENT_DATA_DIR and funded TWAK wallet.
SOLVENT_MODE=paper
SOLVENT_DATA_DIR=/opt/solvent/data
# safety (default) | tournament_50 | conviction_50 | tournament_60
SOLVENT_RISK_PROFILE=safety

# Telegram alerts (BotFather token + chat id). Leave unset to disable.
SOLVENT_TG_BOT_TOKEN=
SOLVENT_TG_CHAT_ID=

# Live trading (--mode live)
# All inherited by the `twak` subprocess via the agent's environment.
# TWAK API credentials are required for quotes, swaps, and competition calls.
# TWAK_ACCESS_ID=
# TWAK_HMAC_SECRET=
# TWAK wallet password signs trades. Optional if the solvent user's TWAK
# keychain is available. Read from env, never argv.
# TWAK_WALLET_PASSWORD=
# Agent wallet key for x402 data payments (CMCSource) + its keystore password.
# SOLVENT_PRIVATE_KEY=
# SOLVENT_WALLET_PASSWORD=
# Trading network + TWAK chain id.
# SOLVENT_TRADE_NETWORK=bsc-mainnet
# SOLVENT_TWAK_CHAIN=bsc
# SOLVENT_WALLET_ADDRESS=         # required in live mode; the TWAK trading wallet

# Regime brain (Claude advisor). Set to 1 to enable; needs ANTHROPIC_API_KEY.
# SOLVENT_USE_ADVISOR=
# ANTHROPIC_API_KEY=

# ERC-8004 receipt anchoring (daily on-chain anchor of the receipt chain head).
# Recommended for the BNB Hack: TWAK keychain on BSC mainnet. No raw private key
# is required by the anchor backend when the solvent user's TWAK wallet is set up.
SOLVENT_ANCHOR_BACKEND=twak
SOLVENT_BSC_NETWORK=bsc-mainnet
# SOLVENT_AGENT_ID=               # from `python -m solvent.receipts.anchor --register`
# SOLVENT_RECEIPTS_URL=https://solvent.gudman.xyz

# Optional: publish each pre-trade commit hash to ERC-8004 before a TWAK swap.
# Adds one on-chain metadata tx before every trade; production enables this
# with a systemd override after SOLVENT_AGENT_ID is set.
# SOLVENT_PRETRADE_ANCHOR=1

# ERC-8183 signal-selling stretch. Buyers create/fund ERC-8183 jobs assigned to
# the agent wallet; the provider serves the latest regime signal and submits a
# hash-verifiable deliverable manifest on-chain through the SDK.
# Only enable this AND expose nginx /erc8183 together: with the service down the
# endpoint 502s. The service refuses to start unless SERVICE_PRICE > 0 — a 0
# price disables the budget floor and lets any caller drain agent gas.
SOLVENT_ERC8183_ENABLED=0
# SOLVENT_ERC8183_NETWORK=bsc-mainnet
# SOLVENT_ERC8183_AGENT_URL=https://solvent.gudman.xyz/erc8183
# SOLVENT_ERC8183_STORAGE_DIR=/opt/solvent/data-prod/erc8183
# Required (> 0) when SOLVENT_ERC8183_ENABLED=1; e.g. 0.05
# SOLVENT_ERC8183_SERVICE_PRICE=0.05
