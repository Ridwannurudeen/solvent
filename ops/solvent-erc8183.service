[Unit]
Description=SOLVENT ERC-8183 signal provider
After=network-online.target
Wants=network-online.target

[Service]
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/solvent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ExecStart=/opt/solvent/.venv/bin/uvicorn solvent.commerce.server:app --host 127.0.0.1 --port 3079
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
