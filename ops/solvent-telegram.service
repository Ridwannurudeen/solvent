[Unit]
Description=SOLVENT Telegram command bot - read-only ops surface
After=network-online.target
Wants=network-online.target

[Service]
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
EnvironmentFile=-/etc/solvent/telegram-alerts
Environment=SOLVENT_PUBLIC_BASE=https://solvent.gudman.xyz
# Read-only service: strip signing secrets it never uses (least privilege).
UnsetEnvironment=SOLVENT_PRIVATE_KEY SOLVENT_WALLET_PASSWORD TWAK_WALLET_PASSWORD TWAK_HMAC_SECRET TWAK_ACCESS_ID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/solvent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ExecStart=/opt/solvent/.venv/bin/python -m solvent.ops.telegram_bot --data-dir /opt/solvent/data-prod --public-base ${SOLVENT_PUBLIC_BASE}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
