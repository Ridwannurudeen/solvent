[Unit]
Description=SOLVENT watchdog — alert if the decision cycle stops running

[Service]
Type=oneshot
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
# Read-only service: strip signing secrets it never uses (least privilege).
# (Telegram alert vars are kept so watchdog can still alert.)
UnsetEnvironment=SOLVENT_PRIVATE_KEY SOLVENT_WALLET_PASSWORD TWAK_WALLET_PASSWORD TWAK_HMAC_SECRET TWAK_ACCESS_ID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/solvent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ExecStart=/opt/solvent/.venv/bin/python -m solvent.ops.watchdog --data-dir ${SOLVENT_DATA_DIR} --max-age 5400
