[Unit]
Description=SOLVENT receipt server — read-only public log over the hash chain
After=network-online.target
Wants=network-online.target

[Service]
User=solvent
WorkingDirectory=/opt/solvent
EnvironmentFile=/opt/solvent/solvent.env
# Read-only service: strip signing secrets it never uses (least privilege).
UnsetEnvironment=SOLVENT_PRIVATE_KEY SOLVENT_WALLET_PASSWORD TWAK_WALLET_PASSWORD TWAK_HMAC_SECRET TWAK_ACCESS_ID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/solvent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ExecStart=/opt/solvent/.venv/bin/python -m solvent.receipts.server --data-dir ${SOLVENT_DATA_DIR} --host 127.0.0.1 --port 3078
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
